# Copia a server/.env (no se sube a git) y llena en el servidor.
PORT=8790
HOST=127.0.0.1
SITE_URL=https://concretosestampados.com
PUBLIC_DIR=/var/www/concretosestampados.com/current
DATA_DIR=/var/lib/bootik
SERVE_STATIC=0
COOKIE_SECURE=1
# Mercado Pago (Tu negocio > Configuración > Credenciales). Sin token = modo demo (no cobra).
# Usa primero las credenciales de PRUEBA (empiezan con TEST- o APP_USR de cuenta de prueba).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=BOOTIK
